{
  "name": "@johnmorrisdotca/hako-devices",
  "version": "0.20.1",
  "description": "Hako Devices 箱: line drawings and 3D views of Raspberry Pis, Macs, PCs, phones, tablets, game consoles, NAS boxes and classic machines, as a web component, with tags to filter 2,200+ machines by CPU, brand and more, and a typed way to assemble machines from parts. No logos. three.js is a peer dependency.",
  "keywords": [
    "devices",
    "device-icons",
    "device-illustrations",
    "device-mockup",
    "device-catalog",
    "hardware",
    "hardware-specs",
    "computers",
    "line-drawing",
    "svg",
    "svg-icons",
    "icons",
    "3d",
    "3d-models",
    "glb",
    "gltf",
    "three",
    "threejs",
    "webgl",
    "web-component",
    "custom-element",
    "react",
    "typescript",
    "zero-dependencies",
    "raspberry-pi",
    "raspberry-pi-zero",
    "single-board-computer",
    "sbc",
    "hat",
    "pitft",
    "apple",
    "mac",
    "macbook",
    "imac",
    "mac-mini",
    "mac-studio",
    "ipad",
    "iphone",
    "airpods",
    "vision-pro",
    "pc",
    "mini-pc",
    "nuc",
    "tablet",
    "phone",
    "nas",
    "tv-box",
    "fire-tv",
    "android-tv",
    "game-console",
    "game-boy",
    "nintendo",
    "playstation",
    "xbox",
    "dreamcast",
    "retro-computing",
    "vintage-computers",
    "amiga",
    "zx-spectrum",
    "macintosh",
    "next",
    "nextcube",
    "nextstation",
    "power-mac",
    "mac-pro",
    "nokia",
    "palm",
    "filter",
    "tags"
  ],
  "homepage": "https://johnmorrisdotca.github.io/hako-devices/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/hako-devices.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/hako-devices/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js",
      "default": "./dist/build/index.js"
    },
    "./tags": {
      "types": "./dist/tags.d.ts",
      "import": "./dist/tags.js",
      "default": "./dist/tags.js"
    },
    "./colours": {
      "types": "./dist/colours.d.ts",
      "import": "./dist/colours.js",
      "default": "./dist/colours.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js",
      "default": "./dist/embed.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./machines.json": "./dist/machines.json",
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/make-assets.ts && node -e \"require('node:fs').copyFileSync('data/machines.json', 'dist/machines.json')\"",
    "assets": "node scripts/make-assets.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.demo.json",
    "test": "node --test test/*.test.ts",
    "test:package": "pnpm build && node scripts/check-package.ts",
    "test:readme": "pnpm build && node scripts/check-readme-examples.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.ts",
    "verify": "pnpm check && node scripts/check-readme-examples.ts && pnpm test:demo",
    "prepublishOnly": "pnpm check",
    "site": "pnpm build && node scripts/site.ts",
    "dev": "pnpm site && node scripts/dev.ts",
    "test:demo": "pnpm site && playwright test",
    "test:usage": "pnpm site && node scripts/check-usage.ts",
    "screenshots": "pnpm site && node scripts/screenshots.ts",
    "wishlist": "node scripts/make-wishlist.ts",
    "family:readme": "node scripts/family-readme.mjs",
    "machines": "node scripts/make-machines.ts",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@eslint/js": "^9.0.0",
    "@johnmorrisdotca/kazoku-ui": "0.19.0",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "marked": "^18.1.3",
    "pagefind": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "three": "0.186.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.6",
    "vue": "^3.5.44",
    "webpack": "^5.112.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
